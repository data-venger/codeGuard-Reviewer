# ── Plane (Ticket Source) ──
PLANE_API_TOKEN=your_plane_api_token_here
PLANE_BASE_URL=https://api.plane.so/api/v1
PLANE_WORKSPACE_SLUG=your-workspace

# ── GitHub ──
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_ORG=your-github-org
GITHUB_REPOS=repo1,repo2

# ── LLM Provider ──
# Options: "ollama" (local, default) or "groq" (cloud, free tier)
LLM_PROVIDER=ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Qdrant ──
# Local (default): set host + port
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Cloud: set URL + API key (overrides host/port)
QDRANT_URL=
QDRANT_API_KEY=

# ── Organisation ──
ORG_NAME=Your Organisation Name

# ── Embedding Model ──
EMBEDDING_MODEL=snowflake/snowflake-arctic-embed-m

# ── Paths ──
STANDARDS_DIR=data/standards
ADRS_DIR=data/adrs
AUTHORS_FILE=data/authors.yaml

