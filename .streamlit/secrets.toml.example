# ── Streamlit Cloud Secrets ──
# Copy this file to .streamlit/secrets.toml and fill in values.
# These override .env when deployed on Streamlit Cloud.

# ── LLM Provider ──
LLM_PROVIDER = "groq"
GROQ_API_KEY = "gsk_your_groq_api_key_here"
GROQ_MODEL = "llama-3.1-8b-instant"

# ── Qdrant Cloud ──
QDRANT_URL = "https://your-cluster-id.region.cloud.qdrant.io"
QDRANT_API_KEY = "your_qdrant_cloud_api_key_here"

# ── GitHub ──
GITHUB_TOKEN = "ghp_your_github_token_here"
GITHUB_ORG = "your-org"
GITHUB_REPOS = "repo1,repo2"

# ── Plane (optional) ──
PLANE_API_TOKEN = "your_plane_api_token_here"
PLANE_BASE_URL = "https://api.plane.so/api/v1"
PLANE_WORKSPACE_SLUG = "your-workspace"

# ── Organisation ──
ORG_NAME = "Your Organisation"
